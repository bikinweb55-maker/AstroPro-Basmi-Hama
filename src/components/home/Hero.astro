---
import Button from "../ui/Button.astro";
---

<section
  class="relative overflow-x-hidden bg-linear-to-br from-primary-900 via-primary-800 to-secondary-900 text-white pb-20 lg:pb-28"
>
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"
    ></div>
  </div>

  <div class="container mx-auto relative z-10 px-6 lg:px-8">

    <div
      class="flex min-h-screen flex-col lg:flex-row items-center justify-between
             pt-32 pb-24
             md:pt-36 md:pb-28
             lg:pt-40 lg:pb-36
             gap-16 lg:gap-20"
    >

      <!-- ================= LEFT ================= -->

      <div class="flex-1 text-center lg:text-left space-y-6 animate-fadeInUp">

        <div
          class="inline-block rounded-full bg-white/10 px-4 py-2 text-sm font-semibold backdrop-blur-sm"
        >
          🚀 Industry-Leading Solutions
        </div>

        <h1
          class="text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl xl:text-7xl"
        >
          Transform Your
          <span class="block text-secondary-300">
            Supply Chain Excellence
          </span>
        </h1>

        <p
          class="mx-auto max-w-2xl text-lg text-primary-100 md:text-xl lg:mx-0"
        >
          Streamline operations with our integrated logistics and manufacturing
          solutions. From warehousing to delivery, we power your success with
          cutting-edge technology and expertise.
        </p>

        <div
          class="flex flex-col gap-4 pt-4 sm:flex-row sm:justify-center lg:justify-start"
        >
          <Button href="/rfq" size="lg" variant="secondary">
            Request a Quote
          </Button>

          <Button
            href="/capabilities"
            size="lg"
            variant="outline"
            class="bg-white/10! border-white! text-white! hover:bg-white/20!"
          >
            Explore Capabilities
          </Button>
        </div>

        <!-- Stats -->

        <div class="grid max-w-2xl grid-cols-3 gap-8 pt-10">

          <div class="text-center lg:text-left">
            <div class="text-3xl font-bold text-secondary-300 lg:text-4xl"></div>
            <div class="mt-1 text-sm text-primary-200"></div>
          </div>

          <div class="text-center lg:text-left">
            <div class="text-3xl font-bold text-secondary-300 lg:text-4xl"></div>
            <div class="mt-1 text-sm text-primary-200"></div>
          </div>

          <div class="text-center lg:text-left">
            <div class="text-3xl font-bold text-secondary-300 lg:text-4xl"></div>
            <div class="mt-1 text-sm text-primary-200"></div>
          </div>

        </div>

      </div>

      <!-- ================= RIGHT ================= -->

      <div class="relative mt-10 flex-1 animate-fadeIn lg:mt-0">

        <div class="relative mx-auto w-full max-w-xl">

          <!-- Glow -->

          <div
            class="absolute -top-8 -right-8 h-72 w-72 rounded-full bg-secondary-500 opacity-20 blur-3xl"
          ></div>

          <div
            class="absolute -bottom-8 -left-8 h-72 w-72 rounded-full bg-primary-500 opacity-20 blur-3xl"
          ></div>

          <!-- Card -->

          <div
            class="relative rounded-3xl glass p-8 lg:p-10 shadow-2xl"
          >

            <div class="grid grid-cols-2 gap-5">

              <div
                class="rounded-xl bg-white/20 p-6 backdrop-blur-sm flex flex-col items-center justify-center"
              >
                <svg
                  class="h-12 w-12 text-secondary-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                  />
                </svg>

                <span class="mt-3 text-sm font-semibold">
                  Warehousing
                </span>
              </div>

              <div
                class="rounded-xl bg-white/20 p-6 backdrop-blur-sm flex flex-col items-center justify-center"
              >
                <svg
                  class="h-12 w-12 text-secondary-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 10V3L4 14h7v7l9-11h-7z"
                  />
                </svg>

                <span class="mt-3 text-sm font-semibold">
                  Fast Delivery
                </span>
              </div>

              <div
                class="rounded-xl bg-white/20 p-6 backdrop-blur-sm flex flex-col items-center justify-center"
              >
                <svg
                  class="h-12 w-12 text-secondary-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                  />
                </svg>

                <span class="mt-3 text-sm font-semibold">
                  Quality Assured
                </span>
              </div>

              <div
                class="rounded-xl bg-white/20 p-6 backdrop-blur-sm flex flex-col items-center justify-center"
              >
                <svg
                  class="h-12 w-12 text-secondary-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>

                <span class="mt-3 text-sm font-semibold">
                  Global Reach
                </span>
              </div>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- Wave -->

  <div class="pointer-events-none absolute -bottom-1 left-0 right-0 leading-none">
    <svg
      viewBox="0 0 1440 120"
      xmlns="http://www.w3.org/2000/svg"
      class="block w-full"
      preserveAspectRatio="none"
    >
      <path
        d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H0Z"
        fill="white"
      />
    </svg>
  </div>
</section>