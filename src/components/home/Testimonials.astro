---
import TestimonialCard from '../ui/TestimonialCard.astro';

import testimonial1Img from '@assets/photo-1494790108377-be9c29b29330.jpg';
import testimonial2Img from '@assets/photo-1507003211169-0a1dd7228f2d.jpg';
import testimonial3Img from '@assets/photo-1438761681033-6461ffad8d80.jpg';

const testimonials= [
  {
    quote: "Sudah sekian kali bekerjasama dengan AstroGemilang untuk mengatasi hama di properti perusahaan kami. Kesan kami sangat puas, karena responsif, ramah, dan ada garansi hama tidak kembali.",
    name: "Novriana Diah",
    role: "General Affair PT. Asik Bersama",
    image: testimonial1Img,
    ringColor: "ring-blue-200"
  },
  {
    quote: "Hama tikus bikin pusing di resto kami. Semenjak minta tolong sama pembasmi hama AstroGemilang, masalah tikus sudah tidak ada lagi. Dapur kami jadi lebih bersih, aman dan higienis.",
    name: "Robert Sutarmanto",
    role: "General Manager Manunggal Resto",
    image: testimonial2Img,
    ringColor: "ring-teal-200"
  },
  {
    quote: "Rumah kami sempat mengalami kerusakan akibat rayap. Setelah hubungi pembasmi hama AstroGemilang, masalah rayap di rumah kami pun teratasi. Kami sangat puas dengan kinerja tim AstroGemilang.",
    name: "Martha Yunita Sari",
    role: "Ibu Rumah Tangga",
    image: testimonial3Img,
    ringColor: "ring-blue-200"
  }
];
---

<section class="py-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-teal-100 text-teal-800 text-sm font-semibold rounded-full">
        Testimonial
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        14 Tahun <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Membangun Kepercayaan</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Inilah testimoni klien tentang kinerja dan pencapaian kami.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <TestimonialCard testimonial={testimonial} variant="home" />
      ))}
    </div>
  </div>
</section>
