---
interface Industry {
  title: string;
  description: string;
  iconGradient: string;
  iconPath: string;
  features: string[];
}

const industries: Industry[] = [
  {
    title: "Area Hunian",
    description: "Kami memberikan layanan basmi hama untuk area hunian, seperti rumah, kost, maupun apartemen.",
    iconGradient: "from-blue-500 to-blue-600",
    iconPath: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6",
    features: ["Rayap", "Nyamuk", "Tikus", "Kecoa",]
  },
  {
    title: "Area Pendidikan",
    description: "Basmi hama untuk area pendidikan seperti sekolah, kampus, dll, untuk memperlancar proses belajar-mengajar.",
    iconGradient: "from-teal-500 to-teal-600",
    iconPath: "M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z",
    features: ["Nyamuk", "Tikus", "Kecoa", "Rayap",]
  },
  {
    title: "Area Hotel & Penginapan",
    description: "Basmi hama untuk keamanan properti, kebersihan, kesehatan dan kenyamanan para tamu di hotel/penginapan Anda.",
    iconGradient: "from-blue-600 to-teal-600",
    iconPath: "M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z",
    features: ["Nyamuk", "Tikus", "Kecoa", "Rayap"]
  },
  {
    title: "Area Perkantoran",
    description: "Basmi hama di area perkantoran, untuk kemanan properti, kenyamanan, kesehatan para pekerja dan para tamu.",
    iconGradient: "from-slate-700 to-slate-800",
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
    features: ["Nyamuk", "Tikus", "Kecoa", "Rayap"]
  },
  {
    title: "Area Niaga dan Kuliner",
    description: "Basmi hama untuk area pertokoan, pasar modern, mall, demikian juga resto, cafe, dll, untuk kemananan dan kenyamanan pengunjung.",
    iconGradient: "from-orange-500 to-orange-600",
    iconPath: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 0a2 2 0 11-4 0 2 2 0 014 0z",
    features: ["Tikus", "Kecoa", "Nyamuk", "Rayap"]
  },
  {
    title: "Area Industri dan Pergudangan",
    description: "Basmi hama untuk melindungi properti, alat, dan aset lainya dari kerusakan akibat hama di properti Anda.",
    iconGradient: "from-purple-500 to-purple-600",
    iconPath: "M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124l-.304-4.873a1.5 1.5 0 00-1.493-1.403H18V10.5a1.5 1.5 0 00-1.5-1.5H13.75M3 14.25V7.5A1.5 1.5 0 014.5 6h9M3 14.25h15m0 0V10.5m-5.25-1.5V6.75a.75.75 0 00-.75-.75h-3.5a.75.75 0 00-.75.75V9m6 0H13.75",
    features: ["Tikus", "rayap", "Kecoa", "Nyamuk"]
  }
];

const checkmarkPath = "M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z";
---

<section class="py-24 bg-linear-to-b from-slate-50 to-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
        Cakupan Layanan Kami
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        Solusi Untuk <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Setiap Poperti</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
         Dengan tim profesional dan berpengalaman, kami selalu siap membantu Anda membasmi hama di berbagai properti, baik hunian maupun bisnis.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {industries.map((industry) => (
        <div class="group bg-white rounded-2xl p-8 shadow-lg hover:shadow-2xl transition-all hover:-translate-y-2 border border-slate-100">
          <div class={`w-16 h-16 rounded-xl bg-linear-to-br ${industry.iconGradient} flex items-center justify-center mb-6 group-hover:scale-110 transition-transform`}>
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={industry.iconPath} />
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-slate-900 mb-3">{industry.title}</h3>
          <p class="text-slate-600 leading-relaxed mb-4">
            {industry.description}
          </p>
          <ul class="space-y-2 text-sm text-slate-600">
            {industry.features.map((feature) => (
              <li class="flex items-center">
                <svg class="w-4 h-4 text-teal-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d={checkmarkPath} clip-rule="evenodd" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- CTA -->
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <!-- Tombol 1: Lihat Layanan Kami (Secondary - Kontras) -->
          <a 
            href="/layanan" 
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg shadow-sm hover:shadow-md transition-all duration-200"
          >
            Lihat Layanan Kami
          </a>

          <!-- Tombol 2: Hubungi Kami via WhatsApp (Primary - Mencolok) -->
          <a 
            href="https://wa.me/6282137343229" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white bg-linear-to-r from-blue-600 to-teal-600 hover:from-blue-700 hover:to-teal-700 rounded-lg shadow-lg hover:shadow-xl transition-all group"
          >
            Hubungi Kami
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
</section>
