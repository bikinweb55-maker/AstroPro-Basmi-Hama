---
import { Image } from 'astro:assets';
import techDashboardImg from '@assets/Jasa-Anti-Rayap-Basmi.jpg';

interface Technology {
  title: string;
  description: string;
  iconGradient: string;
  iconPath: string;
}

const technologies: Technology[] = [
  {
    title: "Respon Cepat",
    description: "Tim kami segera meluncur ke lokasi Anda untuk menghentikan penyebaran hama sebelum merusak properti lebih jauh.",
    iconGradient: "from-blue-500 to-blue-600",
    iconPath: "M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"
  },
  {
    title: "Asesmen Menyeluruh",
    description: "Kami menginspeksi setiap sudut, mendeteksi sarang tersembunyi, dan memberikan solusi permanen agar hama tidak kembali lagi.",
    iconGradient: "from-teal-500 to-teal-600",
    iconPath: "M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z M12 9v6m-3-3h6"
  },
  {
    title: "Bahan Kimia Ramah Lingkungan",
    description: "Kami menggunakan material bersertifikasi resmi yang ampuh membasmi hama namun 100% aman bagi anak-anak, hewan peliharaan, dan lingkungan.",
    iconGradient: "from-blue-500 to-blue-600",
    iconPath: "M9.75 3h4.5M12 3v13.5M4.5 19.5h15a.75.75 0 00.54-1.275l-4.79-5.11a3.75 3.75 0 01-1.05-2.615V6a.75.75 0 00-.75-.75h-3.9a.75.75 0 00-.75.75v4.51c0 .99-.395 1.942-1.05 2.615l-4.79 5.11a.75.75 0 00.54 M12 3v18M12 3a9 9 0 019 9c0 4.97-4.03 9-9 9M12 3a9 9 0 00-9 9c0 4.97 4.03 9 9 9M16.5 10.5C16.5 13 12 16.5 12 16.5S7.5 13 7.5 10.5a4.5 4.5 0 019 0z1.275zm4.5-4.5a3 3 0 116 0c0 1.657-1.343 3-3 3s-3-1.343-3-3z"
  },
  {
    title: "Bergaransi",
    description: "Kami memberikan komitmen pemantauan berkala dan jaminan garansi penanganan ulang secara gratis jika hama muncul kembali selama masa kontrak.",
    iconGradient: "from-teal-500 to-teal-600",
    iconPath: "M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"
  }
];
---

<section class="py-24 bg-linear-to-b from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div>
        <div class="inline-block px-4 py-2 mb-4 bg-white/10 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
          Mengapa Kami
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Solusi Cepat untuk Lingkungan<span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-teal-400"> Yang Aman & Sehat</span>
        </h2>
        <p class="text-xl text-slate-300 mb-8 leading-relaxed">
          Kami memberikan kepastian bebas hama dengan memadukan kecepatan bertindak, ketelitian analisis lokasi, dan penggunaan material bersertifikasi ramah lingkungan.
        </p>

        <!-- Technology Features -->
        <div class="space-y-6">
          {technologies.map((tech) => (
            <div class="flex items-start group">
              <div class={`shrink-0 w-12 h-12 rounded-lg bg-linear-to-br ${tech.iconGradient} flex items-center justify-center mr-4 group-hover:scale-110 transition-transform`}>
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={tech.iconPath} />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-semibold text-white mb-2">{tech.title}</h3>
                <p class="text-slate-400 leading-relaxed">
                  {tech.description}
                </p>
              </div>
            </div>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-10">
          <a 
            href="https://wa.me/6282137343229" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 text-base font-semibold text-white bg-linear-to-r from-blue-600 to-teal-600 hover:from-blue-700 hover:to-teal-700 rounded-lg shadow-lg hover:shadow-xl transition-all group"
          >
            Hubungi Kami Sekarang
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Visual -->
      <div class="relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <Image 
            src={techDashboardImg}
            alt="Advanced logistics technology dashboard"
            class="w-full h-full object-cover"
            width={1200}
            height={800}
          />
          <div class="absolute inset-0 bg-linear-to-br from-blue-900/80 via-teal-900/60 to-blue-900/80"></div>
          <div class="absolute inset-0 flex items-center justify-center p-8">
            <div class="text-center">
              <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-linear-to-br from-blue-500 to-teal-500 flex items-center justify-center shadow-2xl">
                <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-white mb-2">Hubungi Kami Segera</h3>
              <p class="text-slate-300">Dapatkan layanan cepat dan terbaik dari tim kami</p>
            </div>
          </div>
        </div>
        
        <!-- Floating Cards -->
        <div class="absolute -top-4 -right-4 bg-white rounded-lg p-4 shadow-xl z-20 animate-pulse">
          <div class="flex items-center">
            <div class="w-3 h-3 rounded-full bg-green-500 mr-2"></div>
            <span class="text-sm font-semibold text-slate-900">99% Konsumen Puas</span>
          </div>
        </div>
        <div class="absolute -bottom-4 -left-4 bg-white rounded-lg p-4 shadow-xl z-20 animate-pulse" style="animation-delay: 0.5s;">
          <div class="flex items-center">
            <div class="w-3 h-3 rounded-full bg-blue-500 mr-2"></div>
            <span class="text-sm font-semibold text-slate-900">Respon Cepat</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


