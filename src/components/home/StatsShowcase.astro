---
import { Image } from 'astro:assets';
import AnimatedStats from '../react/AnimatedStats';
import logisticsNetworkImg from '@assets/ChatGPT Image Jun 21, 2026, 05_23_28 PM - Copy.png';
---

<section class="relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <Image 
      src={logisticsNetworkImg}
      alt="Fogging, basmi hama"
      class="w-full h-full object-cover"
      width={2070}
      height={1380}
    />
    <div class="absolute inset-0 bg-slate-800/90"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-white/10 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
        Pencapaian Kami
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
        Dipercaya Lebih Dari <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-teal-400">300 Klien</span>
      </h2>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Telah berhasil membuktikan kinerja dan hasil terbaik dalam pembasmian hama di Indonesia.
      </p>
    </div>

    <AnimatedStats client:load />

  {/* Trusted By Section */}
<div class="mt-20">
  <p class="text-center text-slate-400 text-sm font-semibold uppercase tracking-wider mb-8">
    Telah Dipercaya Oleh
  </p>
  
  <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
    
    {/* Amaranta Prambanan */}
    <div class="flex items-center justify-center group">
      <img 
        src="/image-public/logo-amaranta.webp" 
        alt="hotel bintang lima amaranta" 
        class="w-36 h-20 object-contain opacity-70 group-hover:opacity-100 transition-all duration-300"
      />
    </div>

    {/* BNI */}
    <div class="flex items-center justify-center group">
      <img 
        src="/image-public/logo-bni.png" 
        alt="BNI" 
        class="w-36 h-20 object-contain opacity-70 group-hover:opacity-100 transition-all duration-300"
      />
    </div>

    {/* BTPN */}
    <div class="flex items-center justify-center group">
      <img 
        src="/image-public/Bank-BTPN-Syariah-1.png" 
        alt="BTPN" 
        class="w-36 h-20 object-contain opacity-70 group-hover:opacity-100 transition-all duration-300"
      />
    </div>

    {/* Hyatt */}
    <div class="flex items-center justify-center group">
      <img 
        src="/image-public/Park-Hyatt-logo.png" 
        alt="Hyatt" 
        class="w-36 h-20 object-contain opacity-70 group-hover:opacity-100 transition-all duration-300"
      />
    </div>

  </div>
</div>

