---
import { NAVIGATION, SOCIAL_LINKS, SITE } from '@config/site';
import { BugOff } from 'lucide-react';
import { Linkedin, Twitter, Facebook } from 'lucide-react';
---

<footer class="bg-slate-900 text-slate-300">
  <div class="container mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-4">
     
      <!-- Company Info -->
      <div class="lg:col-span-1 space-y-6">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-linear-to-br from-blue-600 to-teal-600">
            <BugOff className="w-7 h-7 text-white" />
          </div>
          <span class="text-2xl font-bold text-white">
            AstroPro
          </span>
        </a>
       
        <p class="text-sm text-slate-400 leading-relaxed max-w-xs">
          {SITE.description}
        </p>
        
        <!-- Alamat Clickable -->
        <div class="text-sm">
          <a
            href="https://maps.app.goo.gl/27DY5qvNppTP6bH27"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-300 hover:text-blue-400 transition-colors inline-flex items-center gap-1 hover:underline group"
          >
            📍 Gang Sadewa, Jalan Besi Jangkang D, Sukoharjo, Ngaglik, Sleman 55581
          </a>
        </div>

        <div class="flex space-x-4">
          <a
            href={SOCIAL_LINKS.linkedin}
            class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-blue-600 hover:text-white transition-all"
            aria-label="LinkedIn"
          >
            <Linkedin className="w-5 h-5" />
          </a>
          <a
            href={SOCIAL_LINKS.twitter}
            class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-blue-400 hover:text-white transition-all"
            aria-label="Twitter"
          >
            <Twitter className="w-5 h-5" />
          </a>
          <a
            href={SOCIAL_LINKS.facebook}
            class="w-10 h-10 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-blue-500 hover:text-white transition-all"
            aria-label="Facebook"
          >
            <Facebook className="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">
          Quick Links
        </h3>
        <ul class="space-y-3">
          {NAVIGATION.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group"
              >
                <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">
          Layanan
        </h3>
        <ul class="space-y-3">
          <li>
            <a href="/layanan" class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              Basmi Rayap
            </a>
          </li>
          <li>
            <a href="/layanan" class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              Basmi Tikus
            </a>
          </li>
          <li>
            <a href="/layanan" class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              Basmi Kecoa
            </a>
          </li>
          <li>
            <a href="/layanan" class="text-sm text-slate-400 hover:text-blue-400 transition-colors inline-flex items-center group">
              <span class="w-0 group-hover:w-2 h-0.5 bg-blue-400 transition-all mr-0 group-hover:mr-2"></span>
              Basmi Nyamuk
            </a>
          </li>
        </ul>
      </div>

      <!-- Logo Partner -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-6">
          Sertifikasi
        </h3>
        <div class="space-y-10 flex flex-col items-start">
          <a href="https://aspphami.or.id" target="_blank" rel="noopener noreferrer">
            <img
              src="https://aspphami.or.id/wp-content/uploads/2025/10/Logo-Aspphami.png"
              alt="Logo ASPPHAMI"
              class="h-34 w-auto object-contain hover:scale-105 transition-transform"
            />
          </a>
        
          <a href="https://peki.or.id" target="_blank" rel="noopener noreferrer">
            <img
              src="https://peki.or.id/wp-content/uploads/2022/09/cropped-logo-header-baru-peki.webp"
              alt="Logo PEKI"
              class="h-17 w-auto object-contain hover:scale-100 transition-transform"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-slate-800">
      <div class="flex flex-col md:flex-row items-center justify-between space-y-4 md:space-y-0">
        <p class="text-sm text-slate-400">
          &copy; {new Date().getFullYear()} {SITE.author}. All rights reserved.
        </p>
        <div class="flex items-center space-x-6 text-sm">
          <a href="/" class="text-slate-400 hover:text-blue-400 transition-colors">
            Privacy Policy
          </a>
          <span class="text-slate-700">•</span>
          <a href="/" class="text-slate-400 hover:text-blue-400 transition-colors">
            Terms of Service
          </a>
          <span class="text-slate-700">•</span>
          <a href="/" class="text-slate-400 hover:text-blue-400 transition-colors">
            Cookie Policy
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>