---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Button from '@components/ui/Button.astro';
import { Image } from 'astro:assets';

import heroBgImg from '@assets/hero-tentang-kami.webp';
import ctaBgImg from '@assets/photo-1553413077-190dd305871c.jpg';
import basmihama1Img from '@assets/fogging-nyamuk.jpg';
import basmihama2Img from '@assets/1.hero.webp';
import basmihama3Img from '@assets/basmiperumahan.png';
---

<BaseLayout title="Tentang Kami">
  <!-- Hero Section -->
  <section class="relative h-[70vh] min-h-[500px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroBgImg}
        alt="Layanan Pembasmian Hama"
        class="w-full h-full object-cover"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-900/95 via-slate-900/80 to-slate-900/50"></div>
    </div>
    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-linear-to-r from-blue-600 to-teal-600 text-white text-sm font-semibold rounded-full shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
          </svg>
          Tentang Kami
        </div>
  
        <h1 class="text-4xl md:text-6xl lg:text-5xl font-bold text-white mb-6 leading-tight">
          14 Tahun Berkarya di <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-teal-400 to-blue-400">
             Layanan Pembasmian Hama
          </span>
        </h1>
  
        <p class="text-xl md:text-2xl text-slate-200 mb-8 max-w-3xl mx-auto leading-relaxed">
          Mitra terpercaya dalam layanan pest control profesional untuk rumah tinggal, perkantoran, restoran, hotel, gudang, pabrik, dan berbagai fasilitas komersial lainnya.
        </p>
      </div>
    </div>
  </section>

  <!-- Solusi Pest Control Profesional Sejak 2012 -->
  <Section background="white">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="relative">
          <Image
            src={basmihama1Img}
            alt="Fogging Nyamuk - Pest Control Profesional"
            class="w-full h-full object-cover rounded-2xl shadow-xl"
            width={800}
            height={600}
          />
        </div>
        <div>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8 leading-tight">
            Solusi Pest Control Profesional <span class="gradient-text">Sejak 2012</span>
          </h2>
          <div class="prose prose-lg text-gray-600 leading-relaxed">
            <p class="mb-6">
              Sejak 2012, kami telah menjadi mitra terpercaya dalam layanan pest control profesional untuk rumah tinggal, perkantoran, restoran, hotel, gudang, pabrik, dan berbagai fasilitas komersial lainnya.
              Dengan pengalaman lebih dari satu dekade, kami menghadirkan solusi pengendalian hama yang efektif, aman, dan disesuaikan dengan kondisi setiap lokasi.
            </p>
            <p>
              Kami menangani berbagai jenis hama, seperti rayap, tikus, kecoa, semut, nyamuk, dan serangga lainnya melalui proses inspeksi yang menyeluruh serta metode penanganan yang tepat.
              Berkomitmen pada kualitas layanan dan kepuasan pelanggan, kami terus memberikan respons cepat, pengerjaan profesional, dan solusi jangka panjang untuk menciptakan lingkungan yang bersih, sehat, dan bebas hama.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Visi & Misi Section -->
  <Section background="gray">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-10">Visi &amp; Misi</h2>
          <div class="space-y-10">
            <div>
              <h3 class="text-2xl font-semibold text-gray-800 mb-4">Visi</h3>
              <p class="text-gray-600 leading-relaxed">
                Menjadi perusahaan pest control terpercaya yang memberikan solusi pengendalian hama profesional melalui pelayanan berkualitas, teknologi yang tepat, serta komitmen terhadap kepuasan pelanggan.
              </p>
            </div>
            <div>
              <h3 class="text-2xl font-semibold text-gray-800 mb-6">Misi</h3>
              <ul class="space-y-4 text-gray-600">
                <li class="flex gap-3"><span class="text-teal-600 font-bold mt-1">•</span> Memberikan layanan pengendalian hama yang efektif dan bertanggung jawab.</li>
                <li class="flex gap-3"><span class="text-teal-600 font-bold mt-1">•</span> Mengutamakan keamanan penghuni, pekerja, serta lingkungan dalam setiap proses treatment.</li>
                <li class="flex gap-3"><span class="text-teal-600 font-bold mt-1">•</span> Menggunakan metode pengendalian yang disesuaikan dengan jenis hama dan kondisi lokasi.</li>
                <li class="flex gap-3"><span class="text-teal-600 font-bold mt-1">•</span> Memberikan edukasi kepada pelanggan mengenai langkah-langkah pencegahan agar infestasi tidak mudah terulang.</li>
                <li class="flex gap-3"><span class="text-teal-600 font-bold mt-1">•</span> Terus meningkatkan kualitas layanan melalui pengembangan pengetahuan, teknologi, dan standar operasional.</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="relative">
          <Image
            src={basmihama2Img}
            alt="Visi dan Misi Perusahaan Pest Control"
            class="w-full h-full object-cover rounded-2xl shadow-xl"
            width={800}
            height={700}
          />
        </div>
      </div>
    </div>
  </Section>

  <!-- Komitmen Kami -->
  <Section background="white">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Left: Image -->
        <div class="relative">
          <Image
            src={basmihama3Img}
            alt="Komitmen Kami Pest Control"
            class="w-full h-full object-cover rounded-2xl shadow-xl"
            width={800}
            height={600}
          />
        </div>

        <!-- Right: Text -->
        <div>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8">Komitmen Kami</h2>
          <div class="prose prose-lg text-gray-600 leading-relaxed">
            <p class="mb-6">
              Kami percaya bahwa layanan pest control bukan sekadar membasmi hama, tetapi juga memberikan rasa aman, menjaga kesehatan lingkungan, dan membantu melindungi aset pelanggan. 
              Oleh karena itu, setiap pekerjaan dilakukan dengan perencanaan yang matang, pemeriksaan lokasi secara menyeluruh, serta rekomendasi tindak lanjut yang sesuai dengan kondisi di lapangan.
            </p>
            <p>
              Kepuasan pelanggan menjadi prioritas utama kami. Kami berkomitmen memberikan pelayanan yang profesional, komunikatif, dan berorientasi pada hasil sehingga setiap pelanggan memperoleh solusi pengendalian hama yang efektif dan berkelanjutan.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- CTA Section -->
  <section class="relative py-32 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={ctaBgImg}
        alt="Hubungi Kami"
        class="w-full h-full object-cover"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-blue-900/95 to-teal-900/95"></div>
    </div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center text-white">
        <div class="inline-block px-4 py-2 mb-6 bg-white/10 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
          Mulai Sekarang
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Siap Membersihkan Hama di Properti Anda?
        </h2>
        <p class="text-xl md:text-2xl text-slate-200 mb-12 max-w-2xl mx-auto leading-relaxed">
          Hubungi tim ahli kami untuk konsultasi gratis, dan dapatkan berbagai penawaran menarik.
        </p>
  
        <div class="flex justify-center">
          <Button 
            href="https://wa.me/6282137343229" 
            size="lg" 
            class="bg-green-600 hover:bg-green-700 text-white shadow-2xl flex items-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.173.198-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.485-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.372-.025-.52-.075-.149-.669-1.612-.917-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.372-.01-.572-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            </svg>
            Konsultasi Gratis
          </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>