---

<BaseLayout title="Layanan Kami - Basmi Hama">
  <section class="relative h-[70vh] min-h-[500px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Image 
        src={herosemprotImg}
        alt="Modern logistics and manufacturing capabilities"
        class="w-full h-full object-cover"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-900/95 via-slate-900/80 to-slate-900/50"></div>
    </div>

    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-linear-to-r from-blue-600 to-teal-600 text-white text-sm font-semibold rounded-full shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
          </svg>
          Solusi Menyeluruh
        </div>
        
        <h1 class="text-4xl md:text-6xl lg:text-5xl font-bold text-white pt-1 mb-6 leading-tight">
          Layanan Basmi Hama <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-teal-400 to-blue-400">
            Untuk Seluruh Properti Anda
          </span>
      </h1>
        
        <p class="text-xl md:text-2xl text-slate-200 mb-8 max-w-3xl mx-auto leading-relaxed">
        Bersama kami, ciptakan lingkungan properti yang lebih bersih, aman, nyaman & higienis, baik untuk hunian maupun bisnis Anda.
      </p>
      </div>
    </div>
  </section>

  <Section background="gray">
  <div class="lg:hidden mb-12">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6">
      <CapabilityAccordion capabilities={capabilities} client:load />
    </div>
  </div>
  
  <div class="hidden lg:block space-y-24">
    <div class="w-full max-w-7xl mx-auto px-8 lg:px-12">
      
      {capabilities.map((capability, index) => (
        <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 items-center ${index % 2 === 1 ? 'lg:grid-flow-dense' : ''}`}>
          <div class={`${index % 2 === 1 ? 'lg:col-start-2' : ''} animate-fadeInUp`}>
            
            <div class="flex items-center justify-center w-16 h-16 rounded-xl bg-linear-to-br from-blue-500 to-teal-500 text-white mb-6 shadow-lg">
              <div class="w-8 h-8 flex items-center justify-center [&>svg]:w-full [&>svg]:h-full [&>svg]:max-w-full [&>svg]:max-h-full" set:html={capability.icon.replace('currentColor', 'white')} />
            </div>

            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              {capability.title}
            </h2>
            <p class="text-lg text-gray-600 mb-6 leading-relaxed">
              {capability.description}
            </p>
            <ul class="space-y-3 mb-8">
  {capability.features.map((feature) => (
    <li class="flex items-center space-x-3">
      <svg
        class="w-5 h-5 text-teal-500 shrink-0"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M5 13l4 4L19 7"
        />
      </svg>
      <span class="text-gray-700">{feature}</span>
    </li>
  ))}
</ul>

<div class="flex flex-col sm:flex-row gap-3">
  <a
    href={`https://wa.me/6282137343229?text=${encodeURIComponent(
      `Halo AstroPro, saya tertarik dengan layanan ${capability.title}. Mohon informasi mengenai harga dan jadwal survei.`
    )}`}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center justify-center rounded-xl bg-blue-600 px-6 py-3 font-semibold text-white shadow-lg transition-all duration-300 hover:bg-green-700 hover:-translate-y-1 hover:shadow-xl"
  >
    <svg
      class="w-5 h-5 mr-2"
      fill="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        d="M20.52 3.48A11.86 11.86 0 0012.05 0C5.45 0 .08 5.37.08 11.97c0 2.11.55 4.17 1.6 5.99L0 24l6.2-1.63a11.94 11.94 0 005.85 1.5h.01c6.6 0 11.97-5.37 11.97-11.97 0-3.2-1.25-6.2-3.51-8.42zm-8.47 18.36a9.9 9.9 0 01-5.05-1.39l-.36-.21-3.68.97.98-3.59-.23-.37a9.88 9.88 0 01-1.52-5.28c0-5.47 4.45-9.92 9.92-9.92 2.65 0 5.14 1.03 7.01 2.91a9.85 9.85 0 012.9 7c0 5.47-4.45 9.92-9.92 9.92zm5.44-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.49-.9-.8-1.5-1.79-1.68-2.09-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.08-.79.37-.27.3-1.04 1.01-1.04 2.46s1.07 2.86 1.22 3.06c.15.2 2.09 3.2 5.07 4.48.71.31 1.27.49 1.71.63.72.23 1.37.2 1.88.12.57-.09 1.76-.72 2.01-1.42.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35z"
      />
    </svg>

    Hubungi Kami
  </a>
</div>
          </div>
          <div class={`${index % 2 === 1 ? 'lg:col-start-1 lg:row-start-1' : ''}`}>
            <ImageReveal client:load delay={index * 0.1}>
              <div class="relative aspect-4/3 group overflow-hidden rounded-2xl shadow-2xl">
                <Image 
                  src={capability.image}
                  alt={capability.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width={1200}
                  height={800}
                />
                <div class="absolute inset-0 bg-linear-to-t from-slate-900/60 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                  <h3 class="text-2xl font-bold mb-2">{capability.title}</h3>
                  <p class="text-gray-200">{capability.description}</p>
                </div>
              </div>
            </ImageReveal>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <Section background="white">
  <!-- 👇 Wrapper Utama FAQ: Mengamankan padding kiri-kanan di semua perangkat -->
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
        FAQ
      </div>

      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Pertanyaan yang Sering
        <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">
          Diajukan
        </span>
      </h2>

      <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Temukan jawaban mengenai layanan pengendalian hama profesional Astro Pro Pest Control.
      </p>
    </div>

    <!-- FAQ List Container -->
    <div class="max-w-4xl mx-auto space-y-4">

      <!-- FAQ ITEM -->
      <details class="group rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:shadow-md">
        <summary class="flex cursor-pointer items-center justify-between gap-6 px-5 md:px-7 py-5 text-left list-none">
          <span class="text-base md:text-lg font-semibold text-gray-900 leading-7">
            Apa itu Astro Pro Pest Control?
          </span>
          <span class="shrink-0 text-2xl font-light transition duration-300 group-open:rotate-45">
            +
          </span>
        </summary>
        <div class="px-5 md:px-7 pb-6 text-gray-600 leading-8">
          Astro Pro adalah layanan pengendalian hama profesional yang melindungi rumah,
          bisnis, dan aset Anda dari berbagai jenis hama seperti rayap, kecoak,
          tikus, semut, lalat, nyamuk hingga kutu busuk menggunakan metode yang
          efektif, aman, dan ramah lingkungan.
        </div>
      </details>

      <details class="group rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:shadow-md">
        <summary class="flex cursor-pointer items-center justify-between gap-6 px-5 md:px-7 py-5 text-left list-none">
          <span class="text-base md:text-lg font-semibold text-gray-900 leading-7">
            Mengapa saya harus memilih Astro Pro dibanding menangani hama sendiri?
          </span>
          <span class="shrink-0 text-2xl font-light transition duration-300 group-open:rotate-45">
            +
          </span>
        </summary>
